{
  "version": 1,
  "agents": {
    "passthroughKeys": [
      "autoCompact",
      "effortControl",
      "visibility"
    ]
  },
  "machine": {
    "managedBy": "professor",
    "retiredAgents": [
      "frr",
      "gpt-executor",
      "gpt-lander",
      "imagine",
      "rr-super",
      "terra",
      "ultimate"
    ],
    "retiredFiles": [
      ".codex/agents/explorer.toml"
    ],
    "sourceGeneratedAgentsDir": "templates/generated/agents",
    "sourceAgentsDir": "templates/global/agents",
    "agentMarkerDir": "templates/global/agents"
  },
  "codex": {
    "globalCommands": true,
    "modelMap": {
      "opus": "gpt-6.1-sol",
      "sonnet": "gpt-6-luna",
      "haiku": "gpt-6-luna",
      "fable": "gpt-6.1-sol"
    },
    "rootAdapter": "\n## Codex adapter \u2014 reading this file in the Codex harness\n\nThis file is compiled from CLAUDE.md by engine-sync codex build; model aliases are already mapped to Codex models. Translate harness mechanics to the matching Codex command or role, and treat generated files as read-only: edit CLAUDE.md and rebuild.\n",
    "agentPreamble": "You are the {{.Name}} role in this repository, running as a native Codex subagent.\nFirst action: read the repository root AGENTS.md in full. Follow its laws and the protocol below exactly; your mode and task come from the dispatch prompt.\n\n",
    "excludeDirs": [],
    "excludeProjects": [],
    "neverRegister": [],
    "suffixMode": "project",
    "suffixPrefix": "",
    "review": {
      "modelAlias": "opus",
      "defaultEffort": "low",
      "prompt": "Review the uncommitted changes only in your task's own files (name them, space separated). Ignore every other path. Report correctness bugs only, most severe first.",
      "slotPrompt": "Review the uncommitted changes only in the flight's files (name them, space separated). Ignore every other path. Report correctness bugs only, most severe first."
    }
  },
  "opencode": {
    "modelMap": {
      "opus": "openai/gpt-6.1-sol",
      "sonnet": "openai/gpt-6.1-sol-fast",
      "haiku": "openai/gpt-5.5-fast",
      "fable": "openai/gpt-6.1-sol"
    },
    "agentPreamble": "You are the {{.Name}} role in this repository, running as a native OpenCode subagent.\nFirst action: read the repository root AGENTS.md in full. Follow its laws and the protocol below exactly; your mode and task come from the dispatch prompt.\n\n",
    "permission": {
      "*": "allow",
      "bash": {
        "*": "allow",
        "git commit": "deny",
        "git commit *": "deny",
        "git push": "deny",
        "git push *": "deny",
        "git tag": "deny",
        "git tag *": "deny",
        "git merge": "deny",
        "git merge *": "deny",
        "git rebase": "deny",
        "git rebase *": "deny",
        "git reset": "deny",
        "git reset *": "deny",
        "git cherry-pick": "deny",
        "git cherry-pick *": "deny",
        "git revert": "deny",
        "git revert *": "deny",
        "git am": "deny",
        "git am *": "deny",
        "git -C * commit": "deny",
        "git -C * commit *": "deny",
        "git -C * push": "deny",
        "git -C * push *": "deny",
        "git -C * tag": "deny",
        "git -C * tag *": "deny",
        "git -C * merge": "deny",
        "git -C * merge *": "deny",
        "git -C * rebase": "deny",
        "git -C * rebase *": "deny",
        "git -C * reset": "deny",
        "git -C * reset *": "deny",
        "git -C * cherry-pick": "deny",
        "git -C * cherry-pick *": "deny",
        "git -C * revert": "deny",
        "git -C * revert *": "deny",
        "git -C * am": "deny",
        "git -C * am *": "deny",
        "gh release*": "deny"
      },
      "doom_loop": "allow",
      "edit": {
        "**": "allow",
        "**/AGENTS.md": "deny",
        ".opencode/**": "deny",
        "AGENTS.md": "deny"
      },
      "external_directory": "allow"
    }
  },
  "mcp": {
    "globalServers": [
      "auto-effort-control",
      "chat-professor",
      "harvester",
      "sub-agent-compact"
    ],
    "renamed": {}
  },
  "workbenchMarker": ".professor/workbench.json",
  "commandDirs": [
    "templates/global/commands"
  ],
  "rewrites": [
    {
      "engines": [
        "codex"
      ],
      "kinds": [
        "agent",
        "command",
        "orientation"
      ],
      "literal": "mcp__plugin_harvester_harvester__",
      "replace": "mcp__harvester__"
    },
    {
      "engines": [
        "opencode"
      ],
      "kinds": [
        "agent-tools"
      ],
      "literal": "mcp__plugin_harvester_harvester__",
      "replace": "mcp__harvester__"
    },
    {
      "engines": [
        "opencode"
      ],
      "kinds": [
        "agent",
        "command",
        "orientation"
      ],
      "literal": "mcp__plugin_harvester_harvester__",
      "replace": "harvester_"
    }
  ]
}
