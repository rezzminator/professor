# {PROJECT_NAME} repo law at the execpolicy layer — loads for EVERY trusted Codex
# session in this repo (builder lanes AND interactive use; the law binds both).
# Mirrors the CLAUDE.md infra law; {PROJECT} is the roster entry whose Makefile
# owns the infra targets. Validate after every edit:
#
#   codex execpolicy check --pretty --rules .codex/rules/repo-law.rules -- git status
#
# The FILENAME is arbitrary — Codex discovers every *.rules file under
# .codex/rules/. Name it after the law, not after the lane that motivated it.
#
# WHAT THIS LAYER IS FOR: the few commands where a wrong call is expensive and a
# prose reminder is not enough. It is a door lock, not a policy document. Keep it
# SHORT. Every rule here has to be maintained against a real CLI's real argv, and
# a rule that can never fire is worse than no rule — it reads as protection while
# protecting nothing. Write the rule, then prove it with `execpolicy check`.
#
# A rejection quoting its justification is THE LAW WORKING. Never rephrase, wrap,
# or shell-trick around one; a genuinely-required rejected command is an escalation.

prefix_rule(
    pattern = ["{DB_CLI}"],
    decision = "forbidden",
    justification = "Infra ops go through the owning project's Makefile — make -C {PROJECT} (repo law); schema changes ship as migration files applied by the test-setup target.",
)

prefix_rule(
    pattern = ["{CONTAINER_RUNTIME}"],
    decision = "forbidden",
    justification = "Infra ops go through the owning project's Makefile — make -C {PROJECT} (repo law); make wraps the container runtime, never call it directly.",
)

prefix_rule(
    pattern = ["{CLOUD_CLI}"],
    decision = "forbidden",
    justification = "Infra ops (queues included) go through the owning project's Makefile — make -C {PROJECT} (repo law).",
)

# ─── OPTIONAL: promoting the git law from prose to a pin ─────────────────────
#
# Shipped COMMENTED OUT because it is not in the working live config, and this
# file does not carry claims it has not earned. In the live pipeline git is NOT
# gated here: it binds as LAW — every role card states that read-only git
# (status/diff/log/show/rev-parse) is the role's, while commits, merges, pushes
# and branch changes are gitter's alone. The generated registry includes that
# one writer, so a repo-wide Git deny would disable the authorized role along
# with everyone else.
#
# Uncomment only if this installation intentionally disables every Git writer,
# including gitter. `codex execpolicy check` is the only way to prove the pin;
# a rule you have not run through the checker is a comment, not a control.
#
# prefix_rule(
#     pattern = ["git", "commit"],
#     decision = "forbidden",
#     justification = "Only gitter commits (repo law). Report the diff and request a gitter dispatch.",
# )
#
# prefix_rule(
#     pattern = ["git", "push"],
#     decision = "forbidden",
#     justification = "Only gitter pushes, and only on an explicit publish request (repo law).",
# )
