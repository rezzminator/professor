# Pinned developer tools — the ONE place a tool version is declared.
# infra/tools.sh installs them on the host (into $TOOLS_BIN) and in the
# pfm-dev image (into /usr/local/bin); Makefile + dev.sh resolve them from
# there, never from whatever PATH happens to carry. Bump here, nowhere else.
# The Go that BUILDS the tools (their formatters embed its go/printer, and
# alignment differs across Go releases). Independent of pfm's own go.mod pin:
# golangci-lint v2.13 needs >= 1.26. Same value on the host and in the image.
TOOLS_GO=go1.27.1
GOLANGCI_LINT_VERSION=v2.13.2
GO_TEST_COVERAGE_VERSION=v2.19.0
JSCPD_VERSION=5.2.1
