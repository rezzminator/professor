# Empty-jail doctor reports an exact hard-failure exit and names every toolchain row.
exec jail-pfm-rc 3 doctor
stdout 'doctor: dep tmux '
stdout 'doctor: dep git '
stdout 'doctor: dep sh '
stdout 'doctor: dep bash '
stdout 'doctor: dep zsh '
stdout 'doctor: dep ps '
stdout 'doctor: dep lsof '
stdout 'doctor: dep script '
stdout 'doctor: dep setsid '
stdout 'doctor: dep nohup '
stdout 'doctor: dep sleep '
stdout 'doctor: dep go '
stdout 'doctor: dep systemctl '
stdout 'doctor: dep systemd-run '
stdout 'doctor: dep launchctl '
stdout 'doctor: dep security '
stdout 'doctor: dep rumdl '
stdout 'doctor: dep claude '
stdout 'doctor: dep codex '
stdout 'doctor: dep uv '
stdout 'doctor: dep harvestpy '
stdout 'doctor: failures=[1-9]'
! stdout 'doctor: clean'
