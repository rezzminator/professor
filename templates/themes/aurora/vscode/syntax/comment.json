      "comment.block.documentation punctuation.definition.inline.tag"
    ],
    "settings": {
      "fontStyle": "italic",
      "foreground": "#a99cf0"
    }
  },
  "0003": {
    "name": "N2+ halo · doc-comment types",
    "scope": [
      "comment.block.documentation entity.name.type",
      "comment.block.documentation entity.name.type.instance"
    ],
    "settings": {
      "fontStyle": "italic",
      "foreground": "#f2d48c"
    }
  },
  "0004": {
    "name": "N2+ halo · doc-comment parameters",
    "scope": [
      "comment.block.documentation variable.other",
