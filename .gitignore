.DS_Store
*.swp
*.bak
node_modules/
.env
.env.*
!.env.example
/tmp/
.worktrees/
# Source-fetched skills are cloned at install from their own public repos
# (templates/skills/sources.json) and are NEVER vendored here: a
# tracked copy is exactly the silent drift the sources.json law exists to
# prevent — and each carries its own upstream LICENSE with its author's name,
# which the leak gate correctly refuses for this repo.
.claude/skills/
# Generated mirrors are never tracked beside their source: their compiler
# (`pfm codex build` for Codex, `build-opencode.mjs generate` for OpenCode)
# writes them at install/init time and the Stop hook keeps them current on
# every later edit. A fresh clone has none of these paths until it generates
# — `pfm codex build .` + `node .claude/scripts/build-opencode.mjs generate`
# — which every gate that reads them runs first (see `scripts/
# check-agent-roster.mjs`'s NOT GENERATED state and the CI `Generate mirrors`
# step). Keepers stay tracked and are NOT covered by these rules:
# `.codex/config.toml` (hand-written, holds one generated `mcp_servers`
# fence), `.codex/rules/**`, `.codex/README.md`, `templates/global/agents/*.md`.
/AGENTS.md
/pfm/AGENTS.md
.codex/agents/
.codex/skills/
.opencode/agent/
.opencode/command/
.opencode/LICENSE
.opencode/SECURITY.md
.opencode/opencode.jsonc
templates/global/agents/*.toml
# OpenCode mirror (build-opencode.mjs): skill symlinks stay untracked like
# .codex/skills/; the goals/ tree is the goal plugin's live session state.
.opencode/skills/
.opencode/goals/
# R&D scratch (walker consumer trees and the like): never a tracked artifact.
.professor/RND/
# Harvester conversion cache and OpenCode's own runtime files (plugin install
# tree, nested config): host state, never repo content.
.cache/
.opencode/.opencode/
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/.gitignore
# Python bytecode caches (harvestpy browser worker dev runs).
__pycache__/

# The scrub table maps real private values to placeholder tokens — it MUST stay local,
# never tracked/public. Untrack with: git rm --cached scripts/placeholder-map.tsv
scripts/placeholder-map.tsv

# leak-check.sh private denylist — names the very things that must never be
# published, so it is never tracked/public. See scripts/leak-check.sh header.
scripts/leak-terms.txt

# rumdl result cache (see /quality:md-forlint) — host state, never repo content.
.rumdl_cache/
