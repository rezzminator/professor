<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.professor.pfm.theme</string>
	<key>ProgramArguments</key>
	<array>
		<string>{bin}</string>
		<string>theme</string>
		<string>sync</string>
	</array>
	<key>WatchPaths</key>
	<array>
		<string>/h/Library/Preferences/.GlobalPreferences.plist</string>
	</array>
	<key>ThrottleInterval</key>
	<integer>1</integer>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{path}</string>
		<key>PFM_INSTALL_MARK</key>
		<string>{mark}</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/h/.local/state/pfm/theme/follow.log</string>
	<key>StandardErrorPath</key>
	<string>/h/.local/state/pfm/theme/follow.log</string>
</dict>
</plist>
