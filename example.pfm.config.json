{
  "version": 2,
  "theme": "default",
  "envs": {},
  "harnessPrompt": null,
  "installPing": true,
  "chat": {
    "backend": "auto",
    "herdrTabStatus": "emoji"
  },
  "herdr": {
    "keys": null
  },
  "state": {
    "db": "~/.local/state/pfm/pfm.db",
    "cacheDb": "~/.local/state/pfm/pfm-cache.db"
  },
  "claude": {
    "permissionMode": "bypass",
    "binary": "claude",
    "theme": null,
    "cache1h": true,
    "remoteControl": true,
    "systemPrompt": "professor",
    "requireManagedCleanup": true,
    "pluginCheckoutRoot": null,
    "pluginSource": "release",
    "plugins": [
      "cache-live-control",
      "forward-compaction",
      "auto-effort",
      "tool-visibility-controller",
      "engine-sync",
      "flights",
      "professor"
    ],
    "env": {},
    "costLedger": true,
    "gptAgents": false,
    "settings": {
      "cleanupPeriodDays": 36500,
      "env": {
        "ANTHROPIC_SMALL_FAST_MODEL": "claude-haiku-5-5",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "100000",
        "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
        "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "8",
        "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "9007199254740991",
        "CLAUDE_CODE_NATIVE_CURSOR": "1",
        "CLAUDE_CODE_TMUX_TRUECOLOR": "1"
      },
      "outputStyle": "default",
      "showThinkingSummaries": true,
      "tui": "fullscreen"
    }
  },
  "codex": {
    "yolo": true,
    "binary": "codex"
  },
  "opencode": {
    "binary": "opencode"
  },
  "tmux": {
    "titles": {
      "enabled": true
    }
  },
  "nameSync": {
    "interval": "15m0s"
  },
  "mcp": {
    "servers": {
      "chat": {
        "enabled": false
      }
    },
    "http": {
      "port": 18377
    },
    "thirdParty": {}
  },
  "ask": {
    "claude": {
      "model": "claude-haiku-4-5",
      "effort": "low"
    },
    "codex": {
      "model": "gpt-5.6-luna",
      "effort": "low"
    },
    "opencode": {
      "model": "gpt-5.6-luna",
      "effort": "low"
    }
  },
  "log": {
    "level": null,
    "components": {},
    "keepFiles": 10,
    "maxMB": 8
  },
  "doctor": {
    "ignoreWarnings": [],
    "acceptedMCP": []
  }
}
