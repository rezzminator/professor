#!/usr/bin/env bash
# pre-push — blocks any push that would leak brand/PII/machine-path strings
# into the public blueprint repo. Wired via `git config core.hooksPath
# .githooks`. Delegates the actual scan to scripts/leak-check.sh.
set -euo pipefail

zero_sha="0000000000000000000000000000000000000000"

repo_root="$(git rev-parse --show-toplevel)"
effective_hooks_path="$(git config --get core.hooksPath 2>/dev/null || true)"
case "$effective_hooks_path" in
  .githooks) ;;
  "$repo_root/.githooks") ;;
  *)
    echo "PUSH BLOCKED: pre-push ran with unexpected core.hooksPath=${effective_hooks_path:-\(unset\)} (want .githooks)" >&2
    exit 1
    ;;
esac
echo "pre-push: gate=armed core.hooksPath=$effective_hooks_path" >&2

# git hands the hook the name of the remote being pushed to (or its URL) as $1.
remote_name="${1:-}"
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip ref deletions (nothing being pushed).
  if [[ "$local_sha" == "$zero_sha" ]]; then
    continue
  fi
  if [[ "$remote_ref" == refs/heads/develop ]]; then arch_tip="$local_sha"; fi

  # main is release-only: it moves when the develop → main release PR merges
  # (gitter Phase RELEASE), never by a direct push. GitHub's ruleset refuses
  # this too; failing here is faster and names the road to take.
  if [[ "$remote_ref" == refs/heads/main ]]; then
    echo "PUSH BLOCKED: refs/heads/main is release-only — push develop and merge the release PR (gh pr merge), never push main directly" >&2
    exit 1
  fi

  # Release protocol wants annotated tags — warn (never block) on lightweight v* tags.
  if [[ "$remote_ref" == refs/tags/v* ]] && [[ "$(git cat-file -t "$local_sha")" == "commit" ]]; then
    echo "WARNING: ${remote_ref#refs/tags/} is a LIGHTWEIGHT tag — protocol wants annotated (git tag -a)" >&2
  fi

  if [[ "$remote_sha" == "$zero_sha" ]]; then
    # No remote counterpart for this ref (e.g. a first-time tag push) — the
    # empty tree is the wrong base, forcing a full-repo scan every time.
    # If the ref's commit sits on the same line of history as origin/main
    # (the common case: an annotated tag on the commit the branch push is
    # already carrying), that content is already what the branch's own
    # scan below covers — reuse origin/main as the base instead. A commit
    # with no such relationship to origin/main still gets a full scan;
    # never silently skip it.
    target_commit="$(git rev-parse "${local_sha}^{commit}" 2>/dev/null || echo "")"
    old=""
    if [[ -n "$target_commit" ]] && git rev-parse --verify -q origin/main >/dev/null 2>&1; then
      remote_main="$(git rev-parse origin/main)"
      if git merge-base --is-ancestor "$remote_main" "$target_commit" 2>/dev/null \
        || git merge-base --is-ancestor "$target_commit" "$remote_main" 2>/dev/null; then
        old="$remote_main"
      fi
    fi
    if [[ -z "$old" ]]; then
      old="$(git hash-object -t tree /dev/null)"
    fi
  else
    old="$remote_sha"
  fi

  remote_args=()
  if [[ -n "$remote_name" ]]; then remote_args=(--remote "$remote_name"); fi
  if ! "$repo_root/scripts/leak-check.sh" --range "$old" "$local_sha" ${remote_args[@]+"${remote_args[@]}"}; then
    failed=1
  fi
done

if [[ "$failed" -ne 0 ]]; then
  echo "PUSH BLOCKED: leak-check failed — nothing was pushed" >&2
  exit 1
fi

# pfm's architecture ratchet (size ceilings, one façade per mechanism, no new
# twins) — the same check CI's Verify runs, so a breach stops here instead of
# turning develop red after the push. It reads the working tree, so it runs
# only when a pushed tip is the checked-out HEAD, and says so when it is not.
arch="$repo_root/pfm/scripts/arch-check.sh"
if [[ -n "${arch_tip:-}" ]]; then
  if [[ ! -f "$arch" ]]; then
    echo "PUSH BLOCKED: pfm architecture check missing at pfm/scripts/arch-check.sh — nothing was pushed" >&2
    exit 1
  elif [[ "$arch_tip" != "$(git rev-parse HEAD)" ]]; then
    echo "pre-push: architecture check not run — pushed tip $arch_tip is not the checked-out HEAD" >&2
  elif ! (cd "$repo_root/pfm" && bash scripts/arch-check.sh) > /tmp/pre-push-arch.$$ 2>&1; then
    grep -E '^CHECK .* (FAIL|ERROR)' /tmp/pre-push-arch.$$ >&2 || cat /tmp/pre-push-arch.$$ >&2
    rm -f /tmp/pre-push-arch.$$
    echo "PUSH BLOCKED: pfm architecture check failed — nothing was pushed (make -C pfm arch)" >&2
    exit 1
  else
    rm -f /tmp/pre-push-arch.$$
    echo "pre-push: pfm architecture check passed" >&2
  fi
fi

exit 0
