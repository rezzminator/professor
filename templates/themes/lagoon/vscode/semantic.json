  "interface": "#f7cd6c",
  "interface.defaultLibrary": "#f7cd6c",
  "interface:rust": {
    "foreground": "#f7cd6c",
    "italic": true
  },
  "keyword": "#ffa28f",
  "label": "#ffa28f",
