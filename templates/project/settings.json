{
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Workflow(*)",
      "Read(*)",
      "Write(*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "export CLAUDE_PROJECT_DIR=\"$(git rev-parse --show-toplevel 2>/dev/null || printf %s \"$CLAUDE_PROJECT_DIR\")\"; \"$CLAUDE_PROJECT_DIR/.claude/scripts/format-md.sh\""
          }
        ]
      }
    ]
  }
}
