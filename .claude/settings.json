{
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/dev.sh:*)",
      "Bash(scripts/leak-check.sh:*)",
      "Bash(scripts/refresh-scope.sh:*)",
      "Bash(engine-sync codex:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Read(*)",
      "Grep(*)",
      "Glob(*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/format-md.sh"
          }
        ]
      }
    ]
  }
}
