      "string.comment",
      "comment.line",
      "comment.block"
    ],
    "settings": {
      "fontStyle": "italic",
      "foreground": "#7280aa"
    }
  },
  "0002": {
    "name": "N2+ halo · doc-comment tags",
    "scope": [
      "comment keyword.codetag",
      "storage.type.class.jsdoc",
