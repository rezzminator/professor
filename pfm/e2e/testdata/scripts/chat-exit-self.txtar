# chat_exit{} from the chat itself, as Claude Code's per-chat proxy stamps the
# call: the tool answers once the finisher is spawned, while the caller's own
# pane is still up (a caller mid-turn could never close before it answers),
# then the finisher types /exit and the hidden chat's pane closes.
exec sh -c 'sed -e "s|@PROC@|$PFM_PROC_ROOT|" -e "s|@SID@|$PFM_SID_DIR|" scenario.tmpl > scenario.json'
env MOCK_ENGINE_SCENARIO=$WORK/scenario.json
exec jail-pfm chat new --engine claude --name worker --cwd $WORK 'map it'
stdout 'worker'
exec jail-until cc-1700000000-4242-7 cc-1700000000-4242-7 mapped
exec jail-pfm mcp chat enable
exec jail-mcp-exit cc-1700000000-4242-7
stdout '"status":"ok"'
stdout 'exit scheduled'
stdout 'alive at return'
exec jail-gone cc-1700000000-4242-7
exec jail-ls-lacks worker

-- scenario.tmpl --
{
  "version": "2.1.238 (Claude Code)",
  "session_id": "b2222222-2222-4222-8222-222222222222",
  "busy_ms": 0,
  "tokens": {"input": 0, "output": 0, "cache_read": 0, "cache_creation": 0, "context_window": 0},
  "jail": {"proc_root": "@PROC@", "sid_dir": "@SID@"},
  "steps": [
    {"type": "turn", "reply": "mapped"}
  ]
}
