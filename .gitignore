.DS_Store
/pfm.config.json
/harvester.config.json
*.swp
*.bak
node_modules/
.env
.env.*
!.env.example
/tmp/
/plugins/tmp/
.worktrees/
# Retired build tree created in the clone by an older SETUP.
/engines/
# Source-fetched skills are cloned at install from their own public repos
# (templates/skills/sources.json) and are NEVER vendored here: a
# tracked copy is exactly the silent drift the sources.json law exists to
# prevent — and each carries its own upstream LICENSE with its author's name,
# which the leak gate correctly refuses for this repo.
.claude/skills/
# Codex command wrappers are tracked so clean checkouts pass mirror checks.
# OpenCode mirror (`engine-sync opencode build`): skill symlinks stay untracked like
# Generated mirrors are never tracked beside their source: their compiler
# (`engine-sync codex build` for Codex, `engine-sync opencode build` for OpenCode)
# writes them at install/init time and the Stop hook keeps them current on
# every later edit. A fresh clone has none of these paths until it generates
# — `engine-sync codex build .` + `engine-sync opencode build .`
# — which every gate that reads them runs first (see `scripts/
# check-agent-roster.mjs`'s NOT GENERATED state and the CI `Generate mirrors`
# step). Keepers stay tracked and are NOT covered by these rules:
# `.codex/config.toml` (hand-written, holds one generated `mcp_servers`
# fence), `templates/global/agents/*.md`.
/AGENTS.md
/pfm/AGENTS.md
/plugins/AGENTS.md
.codex/agents/
.codex/skills/
.opencode/agent/
.opencode/command/
.opencode/LICENSE
.opencode/SECURITY.md
.opencode/opencode.jsonc
templates/global/agents/*.toml
# OpenCode mirror (`engine-sync opencode build`): skill symlinks stay untracked like
# .codex/skills/; the goals/ tree is the goal plugin's live session state.
.opencode/skills/
.opencode/goals/
# RR dig evidence: each run directory's sub-rr/ reports and clone-distiller/
# result files (the top-level clone-distiller/ and tracer-rr/ hold those from
# before run directories) are machine-local (verbatim third-party text, paths
# into /tmp clones); the run's synthesis document stays tracked.
.professor/RR/*/sub-rr/
.professor/RR/*/clone-distiller/
.professor/RR/clone-distiller/
.professor/RR/tracer-rr/
# Harvester conversion cache and OpenCode's own runtime files (plugin install
# tree, nested config): host state, never repo content. `.cache/` is the
# harvester cache's pre-migration name, ignored until `pfm install` renames it.
.harvester-cache/
.cache/
.opencode/.opencode/
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/.gitignore
# Python bytecode caches from python runs outside pfm (pfm's harvestpy launches
# send theirs to $TMPDIR/pfm-pycache).
__pycache__/

# The scrub table maps real private values to placeholder tokens — it MUST stay local,
# never tracked/public. Untrack with: git rm --cached scripts/placeholder-map.tsv
scripts/placeholder-map.tsv

# leak-check.sh private denylist — names the very things that must never be
# published, so it is never tracked/public. See scripts/leak-check.sh header.
scripts/leak-terms.txt

# Fleet prompts are assembled from embedded source parts by pfm install.
/pfm/harness-prompts/generated/

# employer-specific research agents: local only, never tracked
templates/global/agents/bk-*.md
templates/generated/agents/bk-*.md
