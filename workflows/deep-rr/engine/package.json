{
  "name": "deep-rr-engine",
  "version": "3.2.4",
  "private": true,
  "type": "module",
  "description": "Research and Report (RR) Workflow engine — modular source that bundles to ../workflow.js",
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning build.js",
    "verify": "node --disable-warning=ExperimentalWarning verify.js",
    "pretest": "npm run verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "acorn": "^8.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  }
}
